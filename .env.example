# ── Irises — LOCAL .env (ALL OPTIONAL — overrides + local secrets) ──────────────
# You usually DON'T need this file. When Irises boots on top of a hermes/OpenClaw engine it
# auto-detects the backend (OPS_BACKEND), reuses the engine's API key, and inherits the engine's
# model — no .env required. This file is only for (a) OVERRIDING something, or (b) the debug path
# of running Irises standalone with no engine (where you must supply your own LLM key).
#
# Config layers LOWEST → HIGHEST:
#   1. deploy/app.env  — committed baseline (models, pacing, intervals), the SAME file prod uses
#   2. engine discovery — fills/updates OPS_BACKEND, engine key, and the model from your engine
#   3. this local .env  — layered ON TOP, WINS over both (so anything you set here is final)
# Don't duplicate deploy/app.env knobs here — edit those in deploy/app.env so the change also
# applies in prod. Put here only local secrets and the handful of values that MUST differ locally.

# ── Local-only overrides (these SHOULD differ from prod) ──
# DATA_BACKEND=memory               # ephemeral mode: nothing persists (default: SQLite + memory
#                                   # files under IRISES_HOME, ~/.irises — durable across restarts)
# IRISES_HOME=~/.irises             # where the local store lives (irises.db + memories/)
# IRISES_CYCLE_ANCHOR=2026-01-01    # "day 1" of Irises's internal 28-day affect cycle (ISO date).
#                                   # Never surfaced to the user; only sets the hidden mood-baseline
#                                   # phase math. Default 2026-01-01 if unset.
# IRISES_TZ=Asia/Jakarta            # IANA zone for YOUR wall clock: the time Irises reads in chat,
#                                   # quiet hours (9pm-8am), and any reminder you don't name a zone
#                                   # for. Default: this host's own zone (then UTC if it has none) —
#                                   # set this only when the box lives somewhere you don't (a VPS in
#                                   # another region, or a container running on UTC). A per-user
#                                   # `agent_tz` saved from chat still wins over it. The installer
#                                   # writes it when asked (`--tz ZONE`, or the menu's extras step),
#                                   # even when the answer matches the host — an answered question
#                                   # should not come undone the day the box changes region.
NODE_ENV=development

# ── Engine (the deep-work brain — see docs/ENGINES.md) ──
# ALL AUTO-DERIVED AT BOOT when an engine is installed — set these only to override.
# OPS_BACKEND=hermes                # hermes | openclaw — AUTO-DETECTED; set to force one. Unset + no
#                                   # engine found = deep work offline (Convo still chats).
#                                   # OPS_BACKEND=off  → DEBUG/standalone: force offline + skip all
#                                   # engine discovery, even if an engine is installed on this machine.
# ENGINE_MODEL_INHERIT=off          # stop inheriting the engine's model (keep Irises's own models); default on
# HERMES_BASE_URL=http://127.0.0.1:8642
# HERMES_API_KEY=                   # API_SERVER_KEY from ~/.hermes/.env — auto-reused (operator-grade — keep secret)
# HERMES_CAPABILITIES=              # hermes: comma list from web,inbox,files,code,media,scheduling —
#                                   # the OPERATOR's declaration of what this engine can do. Live
#                                   # discovery (GET /v1/toolsets) OVERRIDES it; this covers the cold
#                                   # cache at boot and an engine that's down.
# OPENCLAW_URL=ws://127.0.0.1:18789
# OPENCLAW_TOKEN=                   # gateway.auth.token from the OpenClaw config — auto-reused (operator-grade)
# OPENCLAW_AGENT_ID=main
# OPENCLAW_CAPABILITIES=            # openclaw: SAME closed vocabulary — web,inbox,files,code,media,scheduling.
#                                   # OpenClaw has no discovery path yet, so this is the only source there.
#                                   # Both: unset = unknown (Irises falls back to its static doctrine);
#                                   # unrecognized names are dropped, never shown to a model.
# ENGINE_ONBOARDING=off             # skip the one-time engine-mode onboarding sent at boot (both engines)
#                                   # (see docs/ENGINES.md § Engine onboarding).
# FIRST_MOVE_ENABLED=false          # off = skip the one-time install introduction (engine memory pull
#                                   # + her first text) — see docs/ENGINES.md § First move.
ENGINE_PUSH_TOKEN=                  # guards POST /api/engine/push (engine→Irises proactive delivery)
                                    # (the engine's job environment needs the SAME value as IRISES_PUSH_TOKEN)
# PROACTIVE_DEDUPE_WINDOW_MS=1800000  # how long one proactive dedupe key stays taken (engine retries)
# ENGINE_TIMEOUT_MS=225000          # per-engine-call budget (default: OPS_TASK_TIMEOUT_MS − 15s)
# ENGINE_MAX_CONCURRENT=3           # simultaneous engine agent runs (default 3); a 4th+ queues, then
#                                   # fails honestly. Keep it matched to the engine's OWN concurrent-run
#                                   # cap — hermes 429s past its limit, so raising this blindly just
#                                   # trades a queue wait for a hard failure.
# OPS_CANCEL_ENGINE_ABORT=off       # on give-up (user says stop, or Irises's own leg timeout) also tell
#                                   # the engine to stop working — hermes POST /v1/runs/{id}/stop,
#                                   # OpenClaw's abort+notify RPC. off = drop the connection locally
#                                   # without telling the engine (the old behavior, and the orphaned-run
#                                   # bug this exists to fix). Applies to BOTH engines. Default on.
# OPS_ENGINE_APPROVAL_RELAY=off     # relay hermes's mid-run dangerous-command asks to the person whose
#                                   # look it is and post their yes/no back to that run; off = ignore
#                                   # them, and hermes's own timeout refuses. Turn off when fronted
#                                   # chats that are not yours can reach Irises. Default on.
# HERMES_RUN_TRANSPORT=chat         # runs (default) | chat — which transport a hermes delegation speaks.
#                                   # runs = POST /v1/runs + SSE events, the one that lets stop/steer
#                                   # reach an in-flight leg (see docs/ENGINES.md § Run control); chat =
#                                   # the old blocking /v1/chat/completions body, no run control. Falls
#                                   # back to chat on its own for an image-bearing task or a hermes with
#                                   # no runs API. Default runs.
# HERMES_STREAM=off                 # on = stream the hermes research completion (SSE) so long runs give a
#                                   # live "still producing" heartbeat instead of one silent blocking POST.
#                                   # Default off — turn on only once you've confirmed the deployed hermes
#                                   # streams; a non-streaming endpoint safely falls back to the blocking read.
#                                   # Only affects the chat fallback above — the default runs transport
#                                   # already streams via /v1/runs/{id}/events regardless of this flag.
#                                   # An image-bearing task streams even with this off: hermes stops a
#                                   # chat run only when a streaming client disconnects, so that is how
#                                   # a cancel reaches it.

# ── Channels ──
# Web / CLI debug chat (talk to Irises in the browser or the terminal via `npm run chat`). Served from web/.
# The installer can set this one too — `--web on|off`, or the menu's optional-extras step.
WEB_ENABLED=true
# WEB_DEBUG_HANDLE=web:guest        # synthetic single-user identity for the web debug channel
# WEB_DEBUG_CHAT_ID=web:debug       # synthetic chat id the web channel routes to
# Bridge mode — Irises fronts the engine's OWN messaging (WhatsApp / Telegram / Signal / iMessage / …).
# It turns on automatically when an engine is configured above (OPS_BACKEND) and its irises-bridge plugin
# is installed; nothing to set here. See docs/ENGINES.md.
# BRIDGE_TYPING=off                 # on = forward a typing indicator to the platform THROUGH the engine
#                                   # adapter's own chat-action (feature-detected; safe no-op where the
#                                   # adapter has none — check the plugin's boot log). Default off: with it
#                                   # off, replies land quicker (no invisible per-bubble typing hold).
# BRIDGE_BUBBLE_GAP_MS=400          # on a channel with NO visible typing dots, the gap between multi-bubble
#                                   # sends (the simulated-typing hold is skipped there as dead air). 0 = fire
#                                   # bubbles back-to-back.

# ── Reply pacing (baseline lives in deploy/app.env; override here for local) ──
# TYPING_CPM=1100                   # simulated typing speed (chars/min) — higher = snappier bubbles
# TYPING_DELAY_MAX_MS=2000          # hard cap on any single bubble's typing hold
# TYPING_DELAY_MIN_MS=400           # floor so a short bubble still reads as typed
# TYPING_FIRST_BUBBLE_MAX_MS=600    # tighter cap on bubble 1 (dots were up through the LLM call)
# TYPING_JITTER_PCT=15              # ±% humanizing wobble on the hold
# BATCH_SETTLE_MS=1800              # quiet window before a burst is answered (grows +0.4s/msg, cap 4s)
# STREAM_FIRST_BUBBLE=on            # send her first sentence the moment it is written, on turns no
#                                   # post-check can rewrite; off = the kill switch for a bad early line

# ── Local/dev secrets (never committed) ──
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OPENAI_API_KEY=                   # the generic OpenAI-compatible ("openai") lane — for a host on OpenAI,
                                    # Azure, vLLM, LiteLLM, Groq, deepseek-direct, ollama, a self-hosted gateway…
# OPENAI_BASE_URL=                  # where the openai lane points (default https://api.openai.com/v1). NOTE:
                                    # no :nitro/:online/:floor suffixes on <ROLE>_MODEL_OPENAI — those are OpenRouter-only.
# OPENROUTER_BASE_URL=              # override the openrouter lane endpoint (default https://openrouter.ai/api/v1)
# Riding a hermes/OpenClaw engine? Irises auto-inherits its model + provider + endpoint + key at boot
# (see docs/ENGINES.md) — you usually set NONE of the above. Her voice runs the engine's OWN model on
# every lane she can reach, so the deep-work model's price and pace apply to chat turns too. Want a
# smaller voice? Set <ROLE>_MODEL / <ROLE>_MODEL_OPENROUTER / <ROLE>_MODEL_OPENAI here (they win), or
# ENGINE_MODEL_INHERIT=off to keep Irises's own shipped models throughout.
# Picked a model for Irises's own voice at install time (the setup menu's model step, or
# --model-lane/--model-slug)? Then the installer has already written that choice into THIS file: for
# each of CONVO, CLASSIFY and FALLFIRM a <ROLE>_PROVIDER plus the lane's model key
# (<ROLE>_MODEL for anthropic, <ROLE>_MODEL_OPENROUTER, or <ROLE>_MODEL_OPENAI + OPENAI_BASE_URL),
# the lane's API key above (given to the installer through IRISES_MODEL_API_KEY in the environment,
# never as a flag), and ENGINE_MODEL_INHERIT=off beside them. That last line is the part worth
# knowing: it stops the voice inheriting the engine's key and endpoint as well as its model, so the
# voice runs on the key you supplied and nothing else. Deep work still runs on the engine's own
# model. Edit or delete these lines by hand to go back to inheriting.
DEBUG_TOKEN=                        # gates /debug and the web chat channel; unset = localhost-only
DASHBOARD_PASSWORD=                 # password for the /dashboard admin GUI. Unset = localhost-only:
                                    # the dashboard then answers this machine and refuses every other
                                    # address with a 403, so set a strong one here on anything
                                    # reachable beyond this box. The installer can write it for you: it
                                    # reads it from IRISES_DASHBOARD_PASSWORD in the environment
                                    # (never a flag, never printed).

# Updates: the server checks the git remote for a newer build and mentions it in chat; applying is a
# terminal command on the box — `bash scripts/update.sh` from the Irises folder (Git Bash or WSL2 on
# Windows), which pulls, rebuilds, restarts the server and restarts the engine gateway. There is no
# chat trigger for it. `bash ./scripts/irises.sh` is the same thing as a menu — it shows the pending
# commits first and prints the command it runs. Scripts and deploys keep using the flags.
# Knobs (defaults in deploy/app.env): UPDATE_CHECK_ENABLED,
# UPDATE_CHECK_INTERVAL_MS, UPDATE_CHECK_BRANCH, UPDATE_ANNOUNCE_ENABLED,
# UPDATE_ANNOUNCE_ACTIVE_WINDOW_MS.

# Need to override a baseline knob just for local? You can add any key from deploy/app.env
# here (e.g. CONVO_MODEL=claude-haiku-4-5 to test cheaper) — it wins over deploy/app.env.
# Ops transient-error retry (cheap second pass on the engine after an llm_error):
# OPS_RETRY_ENABLED (default true; false = a transient error degrades to the "transient snag" beat, no retry).
# Walled-URL browser hint: OPS_WALLED_URL_HINT (default on). When the ask carries a link on a
# JavaScript/login-walled host (instagram, tiktok, x, reddit, youtube…) AND the engine reports a real
# browser toolset, the task prompt says to open it with browser_navigate instead of curling a login
# shell — and an empty first pass then buys one browser retry. false = neither, byte-identically.
# Needs the engine's toolset manifest: it stays off until discovery answers (the first delegation of
# a fresh process), and off for good on an engine with only web_search. The `ops:kickoff` receipt
# says which: browserTooling true/false/null (null = nobody could say yet) beside toolingHint.
# Ops progress reporting: OPS_PROGRESS_QUIET_MS (silence before first ping, default 300000),
# OPS_PROGRESS_GAP_MS (min spacing between pings, default 300000), OPS_MAX_PROGRESS_PINGS (hard cap
# on mid-run updates across all legs, default 1).
# Cost guards (defaults in deploy/app.env): LLM_DAILY_TOKEN_CAP, OPS_DAILY_TOKEN_CAP,
# OPS_TASK_TOKEN_BUDGET, OPENROUTER_MAX_TOOL_CALLS_DEFAULT, OPENROUTER_MAX_PRICE_PROMPT/_COMPLETION.
# OPENROUTER_CREDITS_WARN_USD=5     # /dashboard LLM tab turns the OpenRouter balance card red below this ($)
# Memory feature switches (defaults in deploy/app.env): MEMORY_SEMANTIC_RECALL, MEMORY_RECALL_EXPANSION,
# NOTE_GROOM_ENABLED, RELATIONSHIP_CLIMATE_ENABLED, CONVO_THREADING_ENABLED, THREADING_PINGS_ENABLED.
# CONVO_THREADING_ENABLED=false     # off = she stops noticing what recurs in your life (values, tensions,
#                                   # goals, shared phrases) and what you left hanging. It gates BOTH ends —
#                                   # the harvest that writes and the pre-turn read that renders — so the
#                                   # prompt goes byte-identical to an install without the feature straight
#                                   # away. Costs no extra LLM calls when ON (it rides the status envelope
#                                   # she already emits). The stored inventory survives being turned off,
#                                   # so turning it back on restores what was earned; groups never had one.
# THREADING_PINGS_ENABLED=false     # on = she may START a message to ask how a thing you left hanging went.
#                                   # ON by default (configure.sh --pings on|off). It buzzes your phone
#                                   # unprompted, so it is bounded hard — one ping per week, only after 48h of silence, only for a
#                                   # loop 3-21 days old that was never asked about or waved off, never twice
#                                   # about the same thing, quiet hours respected. Watch 'threads:ping' on
#                                   # /dashboard.
# Conversation focus + inner state (baseline + the long form in deploy/app.env). All read per call,
# and ON by default with a byte-identical off path — off is the prompt an install that never had the
# feature would have produced. The ONE exception is MEMORY_PROVENANCE_ENABLED, which is default off
# and says so below. Watch 'turn:trace' on /dashboard for what each one decided.
# CONVO_MEMORY_RELEVANCE=off        # the relevance router (and, with it, the memory gate table and
#                                   # the identity card): what the incoming message touches, read
#                                   # once and shared. off = the old always-render memory stack.
#                                   # Default on.
# CONVO_THEME_TOPIC_GATE=off        # a theme is only offered when it lexically touches the message
#                                   # in hand; loops are unaffected. Default on.
# CONVO_TURN_FOCUS_BLOCK=off        # the last block inside <prompt>: their message, its shape, and
#                                   # the one or two held things that touch it. Default on.
# LEAF_EXAMPLES_EXTRA=              # not a switch: extra comma-separated tokens for the idle gate's
#                                   # English fast path (mkay,yeh) — the stalls this person types
#                                   # that the built-in examples miss. Read per call. A missing token
#                                   # only ever costs one small classify call, so keep the list
#                                   # short, and never list a word work is made of. Default empty.
# CONVO_PERSONA_MODULES=off         # craft pages load only on the turns that need them; off = the
#                                   # whole corpus rides the persona head every turn. Default on.
# AFFECT_DETERMINISTIC=off          # her mood/gauge arithmetic runs in code inside a per-turn cap;
#                                   # off = the gauges freeze where they last stood. Default on.
# TURN_TRACE_ENABLED=off            # the one receipt per delivered reply (section sizes, transcript
#                                   # share, gate verdicts, drift). Default on.
# CONVO_UNKEPT_PROMISE_GUARD=off    # one re-ask when a reply promised a look-up nothing started.
#                                   # Default on.
# CONVO_OUTCOME_PASS=off            # a turn whose reminder or lookup call missed gets one more model
#                                   # call, shown what happened and the live ids, to fix it and reply;
#                                   # off = the miss is voiced as it is. Default on.
# CONVO_ROUTING_GATE_MEMORY_AWARE=off  # the grounding screen stands down for an answer she gave off
#                                   # something she holds, and a real delegation carries that held
#                                   # text to the engine in its own field. Default on.
# MEMORY_PROVENANCE_ENABLED=on      # stamp every durable fact stated | seeded | inferred so a guess
#                                   # is never cited as testimony. The one switch here that is
#                                   # DEFAULT OFF: it changes what a memory file contains, and it
#                                   # earns its way on. Default off.
# DOSSIER_FACT_GUARD_ENABLED=off    # the dossier rewrite may not change their name / what to call
#                                   # them / their zone to something no source said. Default on.
# MEMORY_DOSSIER_EDITS=off          # the long-term dossier is updated as verified, dated line edits
#                                   # (numbered lines in, add/replace/delete ops back) instead of a
#                                   # whole-document rewrite. off = the old rewrite. Default on.
# MEMORY_MEDIUM_SUPERSEDE=off       # a new standing rule or remembered fact retires the ones it
#                                   # reverses or makes obsolete, so a withdrawn rule stops being
#                                   # read. off = the tier only appends. Default on.
# CONVO_HOOKS_ENABLED=off           # the whole hook machinery: the idle gate, the selector, the
#                                   # per-turn hooks section, the hooks craft page and the quiet
#                                   # re-ask. off = none of it is built. It removes the machinery,
#                                   # never the character — rolling HER back is a branch revert, not
#                                   # a switch. Default on.
# MEMORY_MOMENTS_ENABLED=off        # the nightly moments pass (memories/<handle>/MOMENTS.md) and the
#                                   # sampling that offers one back for a callback. off = no pass, no
#                                   # write, no prune, and an existing file is never read. Its own
#                                   # store: a moment never resurfaces through a recall. Default on.
# MEMORY_THESIS_ENABLED=off         # the weekly rewrite of her one read on this person
#                                   # (memories/<handle>/THESIS.md) and the internal per-turn section
#                                   # that hands it to Convo. off = the pass never runs and an
#                                   # existing file goes stale in place. Default on.
# MEMORY_SELF_ENABLED=off           # the daily pass that writes down what SHE said about herself
#                                   # (memories/<handle>/SELF.md: stances, tastes, what she learned,
#                                   # where she changed her mind) and the section that hands it back.
#                                   # off = no pass, no section, the file goes stale. Default on.
# IRISES_MUSINGS_ENABLED=off        # lets her text first because something is on HER mind, apart
#                                   # from anything you set up: at most one a day, daytime, only when
#                                   # you talked in the last week and the chat is quiet. Default on.
# CONVO_SHARE_TURNS_ENABLED=off     # the third turn shape: a message that hands her something and
#                                   # asks for nothing is a share, not a task — the gate's third
#                                   # verdict, the share section beside the turn block, its craft
#                                   # page, and the one follow-up question her mood may leave open.
#                                   # off = a share is answered flat as a task, byte-identical, and
#                                   # that is the way back from a shape that interrogates.
#                                   # Subordinate to the hook switch above. Default on.
# CONVO_FAMILIARITY_ENABLED=off     # the familiarity mask: a 1-100 level of how well she knows each
#                                   # person, arithmetic over what she holds about them and paced by
#                                   # the days you have talked, decides how much of her mood reaches
#                                   # a reply. A stranger gets her composed and the whole weather
#                                   # shows once she knows them; a room is always a stranger; the
#                                   # number never reaches a prompt. It also keeps her own first
#                                   # texts to people she knows. off = every reply compiles as
#                                   # before and nothing is read or written. Default on.
# CONVO_HISTORY_MAX=80              # how many stored messages Convo reads as the transcript. The
#                                   # code default is 40; deploy/app.env ships 80. Default 40.
# LLM lane hygiene — three guards for what a reasoning-family engine model does to calls never sized
# for thinking (see deploy/app.env for the long form):
# LLM_REASONING_DISABLE=off         # say "no reasoning" out loud on roles with none armed, so a
#                                   # 20-token classify cap is not spent entirely on thinking.
#                                   # Default on.
# LLM_STARVED_RETRY=off             # one bounded same-lane retry after a starved (empty, length-
#                                   # capped) reply, before the cross-lane fallback. Default on.
# LLM_CALL_TIMEOUT_MS=0             # hard wall clock on ONE voice call, ms; 0/off = unbounded, which
#                                   # is what hung a local Convo call for 25 minutes. Default 120000.
# Engine legs — the var IS the switch on the first one: unset keeps the standard OPS_TASK_TIMEOUT_MS
# deadline, on|true|yes|1 arms the shipped 15-minute browser window, and a number is taken as
# written (default off):
# OPS_BROWSER_TASK_TIMEOUT_MS=on
# How often a chat's engine TRANSCRIPT starts over: never | weekly | daily. Rotating keeps a flash-
# tier engine model out of a near-full context; the engine-side MEMORY key is never rotated, so
# nothing is forgotten. An unrecognized value warns and rotates weekly anyway (default weekly):
# HERMES_SESSION_ROTATION=never
# IRISES_SKIP_WEB_BUILD=1           # read by the lifecycle scripts, not the server. The web client
#                                   # is rebuilt only where it is already in use (web/out exists) or
#                                   # on request (IRISES_WEB=1), and is skipped anyway under ~1.5 GB
#                                   # of free memory, where `next build` dies mid-way. This var
#                                   # skips it outright. Either way a failed web build never fails
#                                   # the update — it warns, and the server half is unaffected.
