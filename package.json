{
  "name": "irises",
  "version": "1.0.0",
  "description": "Irises — a private, deadpan do-anything companion with one read on you. A multi-agent brain that is the user-facing interface for the OpenClaw/Hermes engines, reachable over a web/CLI debug chat and the engine bridge.",
  "main": "dist/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/criblaurens/Irises.git"
  },
  "keywords": [
    "assistant",
    "ai",
    "claude",
    "anthropic",
    "multi-agent",
    "openclaw",
    "hermes",
    "chatbot",
    "typescript"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc && cpx \"src/agents/**/*.md\" dist/agents && cpx \"src/**/*.txt\" dist && node scripts/stamp-version.js",
    "build:web": "npm --prefix web run build",
    "copy:context": "cpx \"src/agents/**/*.md\" dist/agents && cpx \"src/**/*.txt\" dist",
    "start": "node dist/index.js",
    "chat": "tsx scripts/irises-chat.ts",
    "setup": "bash scripts/irises.sh",
    "install:web": "npm --prefix web install",
    "test": "cross-env TZ=UTC DATA_BACKEND=memory tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "e2e:lifecycle": "bash scripts/e2e/lifecycle-sandbox.sh",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "cron-parser": "^4.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "jsonrepair": "^3.15.0",
    "openai": "^6.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "cpx2": "^9.0.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
