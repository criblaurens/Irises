# ── Irises — app config (COMMITTED baseline) ─────────────────────────
# Non-secret, tweakable config. Edit in your IDE, commit, and ship it to
# /opt/irises/app.env with each deploy, so config changes sync with the code.
#
# NEVER put API keys / secrets here. Those live only in /opt/irises/.env on the VM and
# are never committed or overwritten by a deploy. On any overlapping key, THIS file wins.
#
# Deep work runs on an external ENGINE (hermes-agent or OpenClaw — see docs/ENGINES.md;
# OPS_BACKEND + engine keys live in .env, not here). The model blocks below cover only the
# in-app roles: Convo (chat), Classify (routing micro-calls), and Fallfirm (recovery voicer).

# ── Server ──
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=512   # heap cap so a 1 GB VM doesn't OOM
PORT=8080                               # Caddy proxies here; keep in sync with the Caddyfile

# ── Updates (git-clone installs — apply with: bash scripts/update.sh; see docs/DEPLOY.md § 5) ──
# The running server checks the git remote for a newer build and surfaces it on /health, the
# /dashboard version card, and — woven through Convo — in chat, where it hands over the command
# above. APPLYING is the terminal's alone: the script restarts Irises AND the engine gateway, so
# there is no chat trigger for it and none can be added.
# UPDATE_CHECK_ENABLED=true               # false disarms the periodic remote check entirely
# UPDATE_CHECK_INTERVAL_MS=21600000       # how often to check (default 6h; floored at 15min)
# UPDATE_CHECK_BRANCH=                    # ref to check (default: this clone's current branch)
# UPDATE_ANNOUNCE_ENABLED=true            # false = detect + /health + dashboard only, no chat messages
# UPDATE_ANNOUNCE_ACTIVE_WINDOW_MS=172800000  # "recently active" audience window (default 48h)
# IRISES_SKIP_WEB_BUILD is read by scripts/update.sh and engine-setup.sh, not by the server: =1 skips
# the optional web-client rebuild. Unset, the scripts rebuild the web client only when web/out already
# exists (a previous build proves you use it) or IRISES_WEB=1 asks for it, and only when the box has
# ~1.5 GB of memory free; a failure there warns instead of aborting.

# ── Models — per-agent provider + model ─────────────────────────────────────
# Each agent picks a PRIMARY provider; the first CONFIGURED other lane is the automatic fallback,
# used ONLY on a transient error (5xx / 429 / network) — never to silently switch models.
#   <AGENT>_PROVIDER          anthropic (default) | openrouter | openai   — which lane runs first
#   <AGENT>_MODEL             Anthropic model slug   (used when PROVIDER=anthropic, else a fallback)
#   <AGENT>_MODEL_OPENROUTER  OpenRouter model slug  (used when PROVIDER=openrouter, else a fallback)
#   <AGENT>_MODEL_OPENAI      OpenAI-compatible slug (used when PROVIDER=openai, else a fallback)
# The OpenRouter slug can be ANY OpenRouter model, not just Claude — e.g. openai/gpt-4o,
# google/gemini-2.5-pro, deepseek/deepseek-chat, meta-llama/llama-3.3-70b-instruct.
#
# THREE lanes. anthropic = the native SDK (its base URL comes from the SDK's own ANTHROPIC_BASE_URL,
# so an Anthropic-compatible gateway works out of the box). openrouter and openai are BOTH the OpenAI
# SDK; each takes an env-configurable base URL:
#   OPENROUTER_BASE_URL   default https://openrouter.ai/api/v1
#   OPENAI_BASE_URL       default https://api.openai.com/v1   — point it at ANY OpenAI-compatible
#                         endpoint (OpenAI, Azure OpenAI, vLLM, LiteLLM, Groq, Together, deepseek-direct,
#                         ollama, a self-hosted gateway). NOTE the openai lane sends NO OpenRouter-only
#                         fields, and OpenRouter routing suffixes (:nitro/:online/:floor) are OpenRouter-
#                         ONLY — never put them in <AGENT>_MODEL_OPENAI.
# Keys (secrets in /opt/irises/.env): OPENROUTER_API_KEY for the openrouter lane, OPENAI_API_KEY for
# the openai lane, ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN for anthropic.
#
# ENGINE INHERITANCE (the usual case — see docs/ENGINES.md): when Irises rides on a hermes/OpenClaw
# engine, boot-time discovery inherits the engine's MODEL + provider + endpoint + key so Irises's
# voice speaks on the same model, on the same API, as the engine — on every lane it can reach
# (openrouter, anthropic, openai, and any OpenAI-compatible host). No stand-in slug is substituted on
# any lane; the only reshaping is spelling an id the way its API takes it (the Anthropic Messages lane
# gets a bare `claude-…`, not `anthropic/claude-…`). A host none of the lanes can speak (bedrock,
# vertex, gemini-native, copilot, nous, moa) is not inherited — the voice keeps the models committed
# below. Anything you set here or in .env wins over inheritance; ENGINE_MODEL_INHERIT=off turns it off
# entirely.

# Convo — the real-time chat voice (fast, tool-capable, TEXT-ONLY). Non-text files ride a
# delegated engine look. Convo's tools ride the JSON envelope (toolsViaJson — written tool_calls,
# no native tools param), so the Anthropic fallback slug MUST support structured outputs
# (output_config.format): Sonnet 5 does, Sonnet 4.6 does NOT.
# Primary is CONVO_MODEL_OPENROUTER; Anthropic (CONVO_MODEL, Sonnet 5) is the transient-error fallback.
CONVO_PROVIDER=openrouter
# Sonnet 5, NOT 4.6: 4.6 400s the structured-outputs enforcement per the MUST above and drops every
# Anthropic-fallback turn into the schema-less retry path.
CONVO_MODEL=claude-sonnet-5
# :nitro = OpenRouter's throughput sort — Convo is the hot path a user is actively waiting on, so
# route to the fastest provider for the slug. It resolves gracefully if no curated set exists.
# HEADS UP: while an engine is detected, ENGINE_MODEL_INHERIT (default on) makes boot-time discovery
# override every voice-model value committed here with the engine's own provider AND its own model —
# so this slug is advisory, not binding. Observed on the VPS: all voice roles ran the engine's
# deepseek-v4-flash while this file plainly said gpt-5.6-luna. Set ENGINE_MODEL_INHERIT=off (here or
# in .env) to make these values bind; /health and the /dashboard overview show which models are
# actually live.
CONVO_MODEL_OPENROUTER=openai/gpt-5.6-luna:nitro
# Reasoning effort for the real-time chat voice (env CONVO_EFFORT; low|medium|high|xhigh|max, or off).
# This ARMS reasoning on the OpenRouter lane, so the model spends chain-of-thought tokens against
# CONVO_MAX_TOKENS below — which is why that ceiling is non-binding (64000), so effort can never starve
# the reply. OpenRouter caps effort at 'high' on the wire; the Anthropic fallback (Sonnet 5) applies the
# full level via output_config.effort.
# `low`, from a measured A/B (2026-09-24, 20 turns each, scripts/convergence/results/latency-p1-*),
# run on the deepseek-v4-flash lane the voice inherits from the engine, NOT on the
# CONVO_MODEL_OPENROUTER slug committed above: the typical turn reasons for the same ~250 tokens at low and medium, but
# medium's tail runs to ~1,900 reasoning tokens on idle and share turns, and that tail is where the
# 25-30s replies came from. At high, the median turn spent ~2,800 tokens thinking before its first
# bubble. The replies read as her at both levels.
CONVO_EFFORT=low
# Output ceiling for Convo (env CONVO_MAX_TOKENS). A runaway backstop, NOT a budget — reasoning
# CoT can spend freely without ever hitting finish_reason=length. 64000 is safe because the Anthropic
# fallback lane STREAMS (non-streaming would reject anything above ~21.3k and silently kill the
# fallback); the OpenRouter primary caps far higher.
CONVO_MAX_TOKENS=64000
# Cache Convo's large, stable system prefix (~28k-token persona) on the Anthropic path. It only
# BILLS a difference when Convo is on the Anthropic lane — its transient-error fallback, or a
# deliberate CONVO_PROVIDER=anthropic flip, during which every Convo turn would otherwise run
# UNCACHED. On the OpenRouter primary lane the cache_control marker is a harmless ignored passthrough.
# Convo declares TWO cached spans now (src/llm/callLLM.ts buildAnthropicSystem): the persona head,
# then the slot that is stable within one chat (the tool docs + whichever craft pages loaded).
CONVO_CACHE_SYSTEM=true
# The same cache for Fallfirm, the outcome and holding voice. Its system (persona + Context.md, or
# persona + Progress.md) is byte-identical every call, so it rides as ONE cached span. Like Convo's,
# it only bills a difference on the Anthropic lane; OpenRouter's automatic prefix caching gets the
# benefit of that stable prefix with or without the marker.
FALLFIRM_CACHE_SYSTEM=true

# How many stored messages Convo reads as the transcript. Code default 40; the box runs 80 so a long
# burst still has the earlier half of the conversation in view. The code default stays 40 — the other
# readers narrow it further for their own purpose (the Composer takes the last 10, the group-chat
# classifier the last 4), so this is a cap, not a target. A non-positive or non-numeric value falls
# back to 40 rather than reading zero rows.
CONVO_HISTORY_MAX=80

# The read window's start moves in steps of this many rows, not one row at a time, once a chat
# outgrows CONVO_HISTORY_MAX. A plain newest-N window slides its first row on every turn, so the
# system-prompt-then-history prefix a long chat sends never repeats byte-for-byte — nothing for
# OpenRouter's prefix cache to hit. Holding the start fixed for a run of turns (advancing it only
# in whole CONVO_HISTORY_TRIM_CHUNK-sized jumps) is what lets that prefix actually get cached. Code
# default 20; a non-positive or non-numeric value falls back to it.
CONVO_HISTORY_TRIM_CHUNK=20

# Max RAW bytes per inlined audio/video before it's skipped (base64 inflates ~33%; heap is capped).
LLM_MAX_MEDIA_BYTES=10485760

# How long after the user SENT media it can still be recalled/re-attached (default 24h). When a text
# follow-up refers back to an earlier attachment, the delegated look re-attaches the stashed file
# (media_scope="earlier"); older than this → Irises asks them to resend.
MEDIA_RECALL_TTL_MS=86400000

# Classify — fast routing/labeling calls (Haiku-tier, ~20 tokens).
CLASSIFY_PROVIDER=openrouter
CLASSIFY_MODEL=claude-sonnet-4-6
# :nitro = throughput sort — a hot-path micro-call on every turn, so route to the fastest provider.
CLASSIFY_MODEL_OPENROUTER=openai/gpt-5.6-luna:nitro
CLASSIFY_THINKING=off            # adaptive|on = extended thinking; off = disabled
# OFF, and raising CLASSIFY_MAX_TOKENS cannot make it safe: every classify caller passes its OWN
# per-call max_tokens, which BINDS over the role ceiling — 20 (Convo's group-chat router and the
# ALLOW/REJECT preference screen), 60 (recall query expansion), 200 (the relationship-climate eval),
# 500 (Ops triage), 800 (the note groomer's merge plan), 900 (dossier rewrite). Effort spends
# chain-of-thought against THOSE numbers on both lanes, so the whole budget goes to reasoning and
# the reply arrives empty: the ALLOW/REJECT screen then fails OPEN, group-chat routing fails closed,
# the expansion and the climate eval return nothing usable, triage returns nothing, the groomer's
# plan comes back truncated (and a truncated plan is rejected wholesale), and the dossier rewrite
# persists half a document. Arm it only after the per-call overrides are raised at their call sites.
CLASSIFY_EFFORT=off               # low|medium|high|xhigh|max, or off (per-call caps 20/60/200/500/800/900 bind over CLASSIFY_MAX_TOKENS)
# CLASSIFY_MAX_TOKENS=20         # optional; falls back to 20 (one word BY DESIGN — an output constraint, not a budget)

# Fallfirm — the fallback+confirm voicer (Haiku-tier). Re-voices a failure/confirmation in Irises's
# tone whenever a primary agent couldn't say it itself (Convo tool outcomes, a composer miss). If ITS
# call fails too, code drops to the tiny floor in fallfirm/floor.ts.
FALLFIRM_PROVIDER=openrouter
FALLFIRM_MODEL=claude-sonnet-4-6
# :nitro = throughput sort — the recovery voicer runs AFTER a failure while the user waits, so speed wins.
FALLFIRM_MODEL_OPENROUTER=openai/gpt-5.6-luna:nitro
FALLFIRM_THINKING=off            # adaptive|on = extended thinking; off = disabled
FALLFIRM_EFFORT=high              # low|medium|high|xhigh|max, or off
# FALLFIRM_MAX_TOKENS=8192       # optional; falls back to 8192

# Transcribe — voice-memo transcription. OpenRouter-only (needs an audio-capable model).
# :nitro = throughput sort — transcription is latency-sensitive (a user waiting on their voice memo).
TRANSCRIBE_MODEL=google/gemini-3.5-flash-lite:nitro
# Completion cap for one memo (default 4096, was a hardcoded 1024 ≈ 45s of speech). This call runs on
# the raw SDK outside callLLM, so it has no fallback lane: a memo over the cap comes back truncated
# and is returned with a "[…cut off…]" marker appended rather than dropped. Raise for long memos.
# TRANSCRIBE_MAX_TOKENS=4096

# Semantic recall — an embedding leg beside recall_memory's keyword search over the cold archive,
# so "the vacation house by the water" can find what was written down as "my lake cabin". OFF by
# default: with it off nothing here is read, no client is built, and recall behaves byte for byte
# as it did before. Turning it on costs embedding tokens on the OpenRouter key already configured
# above — a background backfill, never a per-turn call.
MEMORY_SEMANTIC_RECALL=off
# The embedding model. OpenAI-shaped through OpenRouter; anything text-embedding-3 or later
# honours the dimensions setting below (older models ignore it, and a batch that comes back at the
# wrong width is refused rather than stored).
EMBEDDINGS_MODEL=openai/text-embedding-3-small
# Vector width. 512 is a 3x storage saving over the model's native 1536 at no measured recall cost
# at archive scale. 0 or blank = send no dimensions param and take the provider default. CHANGING
# THIS RE-EMBEDS the whole archive (vectors carry their model+width, and mismatched ones are
# ignored by the search until the backfill replaces them).
EMBEDDINGS_DIMENSIONS=512
# Rows per embedding call, and calls per backfill run. The product is the ceiling on one run's
# spend: 96 x 8 = 768 rows/hour, so a full 10,000-row archive fills in over about half a day.
MEMORY_EMBED_BATCH_SIZE=96
MEMORY_EMBED_MAX_BATCHES_PER_RUN=8
# How often the backfill runs (ms). It also runs once 60s after boot.
MEMORY_EMBED_INTERVAL_MS=3600000
# Vectors scanned per query. The scan is brute-force dot products over the SCOPED slice of the
# archive (one user's rows), so this is a cost/latency ceiling, not a quality knob: 10-25ms at the
# default 10000, which is the whole per-handle archive cap. Candidates are taken NEWEST-FIRST, so
# lowering this truncates the semantic leg by recency — set it to 2000 and a memory older than
# your last 2000 archived rows becomes unreachable by meaning, which is the case the feature is
# for. Lower it only to buy latency back, knowing that is what you are selling.
MEMORY_VECTOR_CANDIDATES=10000
# Cosine floor a semantic hit must clear to be fused in at all. Below it, "nearest" only means
# "least unrelated", and such a hit must never displace a real keyword match. Raise to make
# semantic recall stricter; lower to let vaguer associations through.
MEMORY_SEMANTIC_MIN_SCORE=0.25
# Query expansion — the same paraphrase tolerance for installs with NO OpenRouter key, where the
# embeddings above can never arm (Anthropic has no embeddings endpoint). Before the keyword search
# runs, one small classify call on whichever lane this install already has turns the query into a
# few likely synonyms, which are appended AFTER the user's own words so they can only ever fill
# leftover search slots. Costs one tiny call per recall_memory use — nothing else in the tree
# triggers it — and IGNORED entirely while semantic recall's embeddings are active, since the
# vector leg already covers the paraphrase. Any failure falls back to the plain keyword search.
MEMORY_RECALL_EXPANSION=on
# Note grooming — saved "remember this" notes are capped at 20 and evicted oldest-first, and they
# render verbatim into every turn, so a fact the user restated three times over a month costs three
# slots and ages out three distinct notes. After a note is saved, a cheap classify pass folds clear
# duplicates into one — at most once per handle per NOTE_GROOM_THROTTLE_MS below, and only when a
# pure similarity check already found a plausible pair, so most turns never reach a model. Every
# merge is re-validated locally (same fact only, literals kept character-for-character, shorter than
# what it replaces) and the retired notes stay in the archive. false → notes are never merged;
# nothing else changes. Watch 'memory:notes_merged' on /dashboard.
NOTE_GROOM_ENABLED=true
# The per-handle groom window (ms, default 6h). Raise it to spend fewer classify calls on a user who
# saves notes all day; a non-numeric or non-positive value falls back to the 6h default rather than
# to no throttle at all.
# NOTE_GROOM_THROTTLE_MS=21600000
# Relationship climate — the weeks-scale standing register with one person (ease / candor /
# playfulness), nudged by a once-per-22h classify eval inside code-owned floors, ceilings and a
# rolling weekly budget, and rendered as numberless prose inside the internal-weather block. false
# stops BOTH ends: no eval is billed, and every read falls back to the default register, so an
# already-drifted relationship stops colouring her voice immediately. The stored row is left alone —
# turning it back on restores exactly the register that was earned. Groups are skipped structurally
# either way. Watch 'climate:eval' on /dashboard.
RELATIONSHIP_CLIMATE_ENABLED=true
# Conversational threading — the inventory of what one person keeps circling back to (their values,
# tensions, goals, and the phrases you two have coined) plus the things they left hanging with a
# how-did-it-go attached, so a callback can be earned instead of guessed. Harvested from the status
# envelope she already emits on every reply, so it costs ZERO extra LLM calls; which one thing (if
# any) is put in front of her each turn is pure code inside fixed budgets — most turns offer nothing.
# false stops BOTH ends: nothing new is captured, and the pre-turn read falls back to nothing, so the
# prompt goes byte-identical to an install that never had the feature — immediately, with no drifted
# state left surfacing. The stored inventory is left alone; turning it back on restores exactly what
# was earned. Groups are skipped structurally either way — a theme is a property of a person, and a
# room has none. Watch 'threads:harvest' / 'threads:select' on /dashboard.
CONVO_THREADING_ENABLED=true
# Thread-revisit pings — the one part of threading that STARTS a message instead of colouring a
# reply. An hourly local sweep looks for a thing you left hanging that has been quiet for a few days
# with nobody having asked how it went, and texts you one light question about it. DEFAULT ON
# (scripts/configure.sh --pings on|off). It makes a phone buzz at someone who did not write to her,
# so the bounds are hard: at most one ping per person
# per week (persisted, so a restart cannot reset it), nothing sent unless the conversation itself has
# been quiet 48h (an active thread's loops surface in live turns instead), only loops aged 3-21 days
# that were never asked about and never waved off, never a group, and never a second ask about the
# same thing. The week is billed BEFORE the send, so a failed delivery costs the week rather than
# risking the same question twice. Quiet hours apply (unlike a reminder, nobody scheduled this), and
# CONVO_THREADING_ENABLED=false turns it off regardless. Watch 'threads:ping' on /dashboard.
THREADING_PINGS_ENABLED=true
# The first move — the install introduction, and the other half of the pair above. Once, minutes
# after engine-setup.sh finishes, Irises asks the engine she now fronts what it already knows about
# its user (a chat message the engine composes itself; no engine file is ever read — see
# docs/ENGINES.md § Memory boundary), sanitizes the reply at the door, seeds her own empty memory
# with it (a first dossier, one medium fact, up to two thread themes, all stamped second-hand), and
# only then decides whether to speak. She texts first ONLY where the engine confirms it has really
# exchanged messages with them in that exact chat before; unsure, no channel, a garbled reply or a
# 24h give-up all land in nudge mode instead — NO COLD TEXT EVER LEAVES THE BOX, and she folds the
# introduction into her reply to their own first message. DEFAULT ON: exactly one message, once per
# install, minutes after an operator ran that install on purpose — the install IS the consent, and shipping it dark would be the feature not
# existing. One-shot state lives in $IRISES_HOME/first-move.json (default ~/.irises), keyed by
# engine, so restarts, update.sh and an uninstall that keeps your data never re-fire it, and /forget
# me deliberately does not re-arm it (forgetting what she knows about someone is not the same as
# never having met them).
# false = a silent install: no ask, no seed, no introduction, she simply waits to be spoken to.
# ENGINE_ONBOARDING=off only drops the wait-for-doctrine gate; CONVO_THREADING_ENABLED=false only
# skips the seeded themes. Watch 'first-move:*' on /dashboard.
FIRST_MOVE_ENABLED=true

# ── Conversation focus + inner state ────────────────────────────────────────
# The conversation-first phase: what she says next is answered from what they just said, and what
# she holds is evidence beside it rather than a stack she recites. Every switch below is ON by
# default with a byte-identical off path — off is the prompt (or the write) an install that never
# had the feature would have produced — with ONE exception, MEMORY_PROVENANCE_ENABLED, which is
# default off and says why. All of them are read per call, so a flip needs no restart.
# Watch 'turn:trace' on /dashboard: one receipt per delivered reply carries the section sizes, the
# transcript's share of the prompt, every gate's verdict and the affect drift.
#
# The relevance router: one pure read of what the incoming message touches, which every memory gate
# and the turn-focus block then share. off = no router is built, the memory stack runs its old
# always-render path, and the prompt is byte-identical to before the phase. This one switch also
# carries the gate table and the identity card — one flip reverts the whole memory half. Default on.
# CONVO_MEMORY_RELEVANCE=on
# A recurring theme is only offered when it lexically touches the message in hand. off = the theme
# stage stops asking (loops are unaffected either way — their own check points the other way).
# Subordinate to CONVO_THREADING_ENABLED. Default on.
# CONVO_THEME_TOPIC_GATE=on
# The last block inside the per-turn prompt: their message, its shape, and the one or two held
# things that touch it. off = the section is never pushed. Default on.
# CONVO_TURN_FOCUS_BLOCK=on
# NOT a switch — a comma-separated list of extra tokens for the idle gate's English fast path
# (src/persona/idle.ts), read on every call so a live box can widen it with no restart. The gate
# decides whether a reply may carry a hook at all; a short message every one of whose tokens is a
# known English stall ("hmm", "im bored") is read as idle for free, and anything else costs one small
# classify call that reads any language. This list is for the stalls THIS person types that the
# built-in examples miss — LEAF_EXAMPLES_EXTRA=mkay,yeh. Adding a token only ever makes the free path
# wider; it can never make a message work that wasn't. Never put a word a piece of work is made of in
# here (deploy, run, moved) — that is the one way this setting can cost a real answer. Default empty.
# LEAF_EXAMPLES_EXTRA=
# Craft pages (src/agents/convo/craft/*.md) load only on the turns that need them — attachments,
# bursts, onboarding, threading, send order… off = the whole corpus rides the persona head on every
# turn, as it did before. Default on.
# CONVO_PERSONA_MODULES=on
# Her mood/gauge arithmetic runs in code (src/persona/affectDrift.ts) inside a per-turn cap instead
# of being self-graded in the reply envelope. off = the gauges freeze at whatever they last were and
# only the clock-free half of her state keeps moving. Default on.
# AFFECT_DETERMINISTIC=on
# The per-turn receipt itself. Subordinate to DIAGNOSTICS_ENABLED; off = the draft is never even
# built, so the turn does exactly the work it did before the receipt existed. Default on.
# TURN_TRACE_ENABLED=on
# The honesty backstop: a reply that promised a look-up she never started gets one re-ask instead of
# a silent broken promise. off = the scan never runs and the reply ships as written. Default on.
# CONVO_UNKEPT_PROMISE_GUARD=on
# The outcome pass: a turn whose reminder or lookup call missed (no match, several fits, a held
# duplicate) gets one more convo call, shown every result and the live ids, so it can fix the call by
# id and reply in her words. off = the miss is voiced by the relay voice as it was before. Default on.
# CONVO_OUTCOME_PASS=on
# The memory-aware half of the grounding screen: it stands down when she answered a data question
# off something she already holds, and a delegation that does happen carries that held text to the
# engine in its own field (never inside the brief). off = text-only screening, as before.
# ROUTING_GATE=off is still the switch for the whole floor. Default on.
# CONVO_ROUTING_GATE_MEMORY_AWARE=on
# Who says so: every durable fact is stamped stated | seeded | inferred, and the render groups them
# so a guess is never cited as testimony. DEFAULT OFF — the one default-off switch here, because it
# changes what a durable memory file contains; the read side parses stamps either way, so an install
# that ran it on and then off still reads its own rows. Default off.
# MEMORY_PROVENANCE_ENABLED=off
# The dossier rewrite may not change a keyed fact (their name, what to call them, their zone) to
# something no source ever said — the guard restores the stored value and files a receipt. off = the
# document is written exactly as the model wrote it. Default on.
# DOSSIER_FACT_GUARD_ENABLED=on
# The long-term dossier is updated as verified line edits — the model sees numbered lines and returns
# add/replace/delete ops that code checks against the line each one quotes, dates, and size-caps.
# off = the old whole-document rewrite, which froze once the doc outgrew its reply budget.
# Default on.
# MEMORY_DOSSIER_EDITS=on
# A new standing rule or remembered fact retires the ones it reverses or makes obsolete — one small
# classify call names them, code supersedes them with lineage, and a rule the user withdrew stops
# being read by every lane. off = the tier only appends, so two rules that disagree both stand.
# Default on.
# MEMORY_MEDIUM_SUPERSEDE=on
# The hook machinery: the gate that reads whether a turn asked for anything, the selector that picks
# the ONE extra beat an idle reply may carry, the per-turn hooks section, the hooks craft page and
# the re-ask that holds the quiet after three sharp replies. off = none of it is built and the turn
# does exactly the work it did before any of it existed. It removes the MACHINERY, never the
# character: the task/idle law is prose in her persona, and prose has no switch — a character
# rollback is a branch revert, not this. Watch 'hooks:select' and 'convo:quiet_guard' on /dashboard.
# Default on.
# CONVO_HOOKS_ENABLED=on
# Moments: the nightly pass that writes what she noticed about this person — habits, obsessions, the
# embarrassing ones — to memories/<handle>/MOMENTS.md, plus the sampling that offers one back for a
# callback. off = no pass runs, nothing is written or pruned, and a file an earlier install left is
# never read. Its own store on purpose: a moment is never archived and never resurfaces through a
# memory recall, and /forget wipes the file either way. Watch 'moments:harvest'. Default on.
# MEMORY_MOMENTS_ENABLED=on
# The thesis: the weekly rewrite of her one read on this person (memories/<handle>/THESIS.md) and the
# per-turn section that hands it to Convo, where every judgment is made of it. INTERNAL — never
# recited, never named to them. off = the pass never runs and the section never renders, so an
# existing file goes stale in place instead of being deleted, which is why turning it back on costs a
# week rather than a restart. Watch 'thesis:rewrite'. Default on.
# MEMORY_THESIS_ENABLED=on
# Her self: the daily pass that writes down what SHE asserted with this person (memories/<handle>/
# SELF.md: the sides she took, what she likes and hates, what she learned from them, where she changed
# her mind) and the per-turn section that hands it back, so a take she argued for last week is still
# hers. INTERNAL, never read out. off = no pass, no section, the file goes stale in place. Watch
# 'self:harvest'. Default on.
# MEMORY_SELF_ENABLED=on
# Her own texts: an hourly sweep that sometimes lets her start a conversation because something is on
# HER mind (a stance, a moment, a theme of theirs), on a line of its own, apart from every reminder,
# watch and cron job. Bounds: at most one a day, never a second one they have not answered, daytime
# where they are, only when they talked in the last week and the chat has been quiet three hours,
# never a room, and never when her weather is low. Watch 'musings:sweep'. Default on.
# IRISES_MUSINGS_ENABLED=on
# The third turn shape: a message that hands her something and asks for nothing is a SHARE, not a
# task and not a stall. On one the idle gate returns a third verdict, the share section beside the
# turn block names the one move that reply may carry, its craft page loads, the drift anchor reads
# for it, and the affect compiler may leave ONE follow-up question open — the only question of hers
# that is a move rather than a probe, closed again by a flat or hostile mood, a spent social
# battery, or a question she already asked last turn. off = the gate maps a share back onto a task
# and the reply is flat exactly as it was before the shape existed, byte-identical down to the
# bytes — which is what makes this switch the way back: a shape that starts interrogating is
# stopped with a word here and a restart, not with a revert and a deploy.
# Subordinate to CONVO_HOOKS_ENABLED — with the machinery off there is no gate to read a third
# shape. It shipped OFF for the length of the series that built it, so every half-built commit was
# inert on a live box; it is on now because that series is whole. Watch 'hooks:select' mode:'share'
# and 'idle:classify' verdict:'share' on /dashboard. Default on.
# CONVO_SHARE_TURNS_ENABLED=on
# The familiarity mask: a 1-100 level of how well she knows each person, kept per handle and made of
# arithmetic over what she already holds about them (turns, the days you talked, facts by who said
# so, moments, themes you picked up, open loops, her own stances), paced by the days you have
# actually talked and moved at most two points a turn. It decides how much of her mood reaches a
# reply: a stranger gets her composed, with only the shape and the energy of the mood showing, and
# the layers open in order, positive before negative, until the whole weather shows for someone
# close. Rapport landing badly pulls it back up a band, a room is always a stranger, asked how she
# is she answers true at every band, and the number never reaches a prompt, /health or a reply. It
# also keeps her own first texts to people she knows. off = every reply compiles as before and
# nothing is read or written. It shipped OFF for the length of the series that built it, so every
# half-built commit was inert on a live box; it is on now because that series is whole. Watch
# 'familiarity:band' and the Inner state panel on /dashboard. Default on.
# CONVO_FAMILIARITY_ENABLED=on

# OpenRouter PDF parsing engine (only used when a PDF is read via an OpenRouter model):
# cloudflare-ai (free, default) | mistral-ocr (paid, best for scans) | native (file-native models).
OPENROUTER_PDF_ENGINE=cloudflare-ai

# ── Cost guards ─────────────────────────────────────────────────────────────
# Daily billed-token kill switches over the local token_usage ledger (UTC day, 5-min cached —
# can overshoot one cache window). Tripping fails LOUD (nonFallbackable; the run gives up,
# never re-bills the other lane). The /dashboard LLM tab shows live spend vs these caps.
# The ledger always exists now (SQLite under IRISES_HOME), so these enforce out of the box.
# Sized ~5-10x a normal day: smoke alarms, not throttles. 0/unset = OFF.
OPS_DAILY_TOKEN_CAP=10000000     # the ops role
LLM_DAILY_TOKEN_CAP=20000000     # every role combined
# Per-task token budget: each delegated leg gets its own fresh allowance; over → wrap up,
# give_up on a miss.
OPS_TASK_TOKEN_BUDGET=750000
# Always-on server-tool ceiling on EVERY OpenRouter request (code default 8; 0 = omit the field).
# Bounds server-side/internal browsing even on requests with NO web_search tool.
# OPENROUTER_MAX_TOOL_CALLS_DEFAULT=8
# Always-on guards, shown with their code defaults (src/llm/budget.ts):
# LLM_MAX_INPUT_TOKENS_EST=150000    # per-call estimated text-input ceiling (base64 exempt)
# Optional OpenRouter provider unit-price FILTER ($/Mtok) — drift protection, NOT a spend cap
# (a cost bomb is volume at an ordinary unit price):
# OPENROUTER_MAX_PRICE_PROMPT=
# OPENROUTER_MAX_PRICE_COMPLETION=
# Dashboard OpenRouter credit-runway warning floor ($). The /dashboard LLM tab's Today strip shows
# the live balance and turns it red below this. When OpenRouter runs out of credits it returns 402
# on every call; OpenRouter-primary roles then degrade to their Anthropic fallback lane (see
# fallbackPolicy.ts) — this card is the heads-up to top up before that happens. Default 5.
# OPENROUTER_CREDITS_WARN_USD=5

# ── LLM lane hygiene ────────────────────────────────────────────────────────
# Three guards for what a reasoning-family model does to calls that were never sized for thinking.
# All read per call; all off paths are the wire request byte for byte as it was.
# Say "no reasoning" out loud on roles that have none armed: engine inheritance puts the host
# engine's model on every voice role, and a reasoning model spends a 20-token classify cap entirely
# on thinking, so the reply arrives empty (the reason the relationship climate never moved in
# production). Sends reasoning:{enabled:false}; a provider that ignores it is exactly today.
# Default on.
# LLM_REASONING_DISABLE=on
# ONE bounded same-lane retry after a starved reply (finish_reason=length with nothing in it).
# off = a starved reply throws straight to the cross-lane fallback, as before. Default on.
# LLM_STARVED_RETRY=on
# Hard wall clock on ONE voice-lane call, in ms. 0|off = no bound at all, which is what this did
# before: a local Convo call once hung 25 minutes on the OpenRouter lane, since the only limits in
# play were the SDK's own 600s timeout times its retries. Junk falls back to the bound rather than
# removing it. Default 120000.
# LLM_CALL_TIMEOUT_MS=120000

# ── Delegated-run pacing ──
# OPS_TASK_TIMEOUT_MS=240000     # wall-clock ceiling on ONE delegated engine run (orchestrator deadline)
# Cheap recovery for a TRANSIENT lane failure (llm_error / rate_limited): triage runs ONE more pass
# on the same engine — a blip that has since cleared is recovered at a fraction of the cost. One
# retry per attempt, bounded by the same per-leg budget + timeout as the primary. ENABLED=false → a
# transient error skips the retry and degrades straight to the "transient snag" beat. Watch
# 'ops:retry' / 'ops:retry-result' on /dashboard.
OPS_RETRY_ENABLED=true
# Walled-URL browser hint: when the ask carries a link on a JavaScript/login-walled host (instagram,
# tiktok, x, reddit, youtube…) AND the engine reports a real browser toolset, the task prompt says to
# open it with the browser instead of curling a login shell — and an empty first pass then buys one
# browser retry. off = neither half, byte-identically. It stays inert until engine discovery answers
# (the first delegation of a fresh process) and on an engine with only web_search; the 'ops:kickoff'
# receipt says which (browserTooling true/false/null beside toolingHint). Default on.
# OPS_WALLED_URL_HINT=on
# The wider leg deadline for a task the engine was told to open a browser for. The var IS the switch:
# unset means every leg keeps the OPS_TASK_TIMEOUT_MS deadline above; on|true|yes|1 arms the shipped
# 15-minute window (the live re-tests needed 6-15 min of browser work and were being cut at ~225s);
# a number is taken as written. Default off.
# OPS_BROWSER_TASK_TIMEOUT_MS=off
# How often a chat's engine TRANSCRIPT starts over: never | weekly | daily. Rotating is what keeps a
# flash-tier engine model out of a near-full context; 'never' is the byte-identical pre-rotation
# behaviour. The engine-side MEMORY key is deliberately never rotated, so nothing is forgotten. An
# unrecognized value warns and rotates weekly anyway (a typo must not silently disable it).
# Default weekly.
# HERMES_SESSION_ROTATION=weekly
# On give-up (user says stop, or Irises's own leg timeout) also tell the engine to stop working —
# hermes POST /v1/runs/{id}/stop, OpenClaw's abort+notify RPC. off = drop the connection locally
# without telling the engine (the old behavior, and the orphaned-run bug this exists to fix).
# Applies to BOTH engines. Default on.
# OPS_CANCEL_ENGINE_ABORT=on
# Which transport a hermes delegation speaks: runs = POST /v1/runs + SSE events, the one that lets
# stop/steer reach an in-flight leg (see docs/ENGINES.md § Run control); chat = the old blocking
# /v1/chat/completions body, no run control. Falls back to chat on its own for an image-bearing
# task or a hermes with no runs API. Default runs.
# HERMES_RUN_TRANSPORT=runs
# Progress reporting — how often/many mid-run "still on it" reassurances can fire.
OPS_PROGRESS_QUIET_MS=300000
OPS_PROGRESS_GAP_MS=300000
OPS_MAX_PROGRESS_PINGS=1

# ── Reply pacing ──
# Burst batching (message-driven ROLLING window; does NOT use the flaky user typing indicator):
# wait for quiet after the LAST message; every new message RESETS that window. The window GROWS
# with the burst — base BATCH_SETTLE_MS, +BATCH_SETTLE_INCREMENT_MS per extra message, capped at
# BATCH_MAX_SETTLE_MS (e.g. 1.8s, 2.2s, 2.6s, … up to 4s) — so the more they're firing off, the longer
# we wait for the next one. No total-time ceiling: the whole burst is compiled, answered once quiet.
BATCH_SETTLE_MS=1800
BATCH_SETTLE_INCREMENT_MS=400
BATCH_MAX_SETTLE_MS=4000
USER_QUIET_WAIT_MS=600
# Stream her first sentence out (env STREAM_FIRST_BUBBLE; on|off, default on). On a turn no
# post-check can rewrite, the first sentence of her first bubble is sent the moment the model has
# written it, instead of waiting for the whole reply to finish and be checked. `off` is the kill
# switch: set it if a live turn ever ships a bad early sentence.
# Measured gain on deepseek-v4-flash via OpenRouter was small, 0.1-0.5s, because that provider emits
# the whole envelope content in one burst after reasoning ends, so there is little to get ahead of.
STREAM_FIRST_BUBBLE=on
# Simulated typing ("fast but human"): chars/TYPING_CPM per bubble, clamped to
# [TYPING_DELAY_MIN_MS, TYPING_DELAY_MAX_MS] with ±TYPING_JITTER_PCT% wobble. The FIRST bubble is
# additionally capped at TYPING_FIRST_BUBBLE_MAX_MS — the user already sat through batching + the
# LLM call with dots showing, so it lands soon after the model answers. Tightened for snappier replies
# (CPM 800→1100, caps lowered) — this hold only runs where typing dots are actually VISIBLE (web, or
# the bridge with BRIDGE_TYPING on); on a no-dots channel it's skipped as dead air (see BRIDGE_BUBBLE_GAP_MS).
TYPING_CPM=1100
TYPING_DELAY_MAX_MS=2000
TYPING_DELAY_MIN_MS=400
TYPING_FIRST_BUBBLE_MAX_MS=600
TYPING_JITTER_PCT=15
TYPING_REFRESH_MS=2000
# Bridge typing (engine-fronted platforms): off = no typing dots, and the per-bubble hold above is
# skipped as invisible dead air → quicker replies. on = forward a typing action THROUGH the engine
# adapter's own chat-action (feature-detected; safe no-op where the adapter has none). See docs/ENGINES.md.
BRIDGE_TYPING=off
BRIDGE_BUBBLE_GAP_MS=400          # gap between multi-bubble sends on a no-dots channel; 0 = back-to-back
# FOLLOWUP_VOICE_TIMEOUT_MS=120000  # ceiling on voicing ONE queued follow-up under the per-chat send lock
# CONTACT_CARD_PROMO=false          # true = re-share Irises's contact card every N messages (off: reads as self-promo)
# CONTACT_CARD_INTERVAL=5           # N, when the promo above is on (the first-message share always happens)

# ── Routing + memory sweeps ──
# ROUTING_GATE=on                # off = disable the post-turn safety net that force-delegates a turn whose bubbles promised a look-up
# MEMORY_SHORT_SWEEP_GRACE_MS=172800000  # how long PAST expiry short-term rows survive (~72h physical retention; swept hourly)
# TOKEN_USAGE_MAX_AGE_DAYS=90    # daily age-out for the LLM call ledger (it was unbounded before)
# (The memory feature flags — semantic recall, query expansion, note grooming, relationship climate
#  — live together in the memory block above, with the knobs they belong to.)

# ── Diagnostics (the DEBUG_TOKEN is a secret in /opt/irises/.env) ──
DIAGNOSTICS_ENABLED=true
# Per-string cap on recorded payloads shown in /debug + /dashboard. 0 = unlimited (verbatim,
# byte-for-byte). Only the diagnostics COPY is ever capped — the API always gets the full prompt,
# and token_usage (the forensics ledger with per-call latency/token counts) is a separate DB table,
# unaffected. 8000 bounds the synchronous per-call deep-clone of 64k-token wire responses
# (main-thread CPU + heap churn on a 1 GB VM). Set 0 to restore verbatim trace payloads.
DIAGNOSTICS_STR_CAP=0
# In-memory trace ring sizing + the persisted turn history (all optional; code defaults shown):
# DIAGNOSTICS_TURNS_PER_CHAT=20        # turns retained per chat in the live trace buffer
# DIAGNOSTICS_EVENTS_PER_TURN=400      # events retained per turn
# DIAGNOSTICS_TURN_IDLE_MS=120000      # idle gap that closes a turn
# DIAGNOSTICS_PERSIST_RAW=false        # true = persist raw wire payloads with the turn history
# DIAGNOSTIC_HISTORY_KEEP=50           # persisted turns kept per chat
# DIAGNOSTIC_HISTORY_MAX_AGE_DAYS=30   # age-out for persisted turns

# ── Error log (the /dashboard Errors tab) ──
# Every thrown/logged failure is folded by signature and persisted. Pruned on a 6h interval.
# ERROR_LOG_MAX_AGE_DAYS=30
# ERROR_LOG_KEEP_ROWS=20000
