# --- server (repo root: the Irises brain) ---
node_modules/
dist/
*.log
npm-debug.log*
*.tsbuildinfo

# The old setup script wrote a SECOND pidfile into the clone root while the server wrote its own to
# $IRISES_HOME. There is one pidfile now ($IRISES_HOME/irises.pid); this keeps a stale one from a
# pre-rewrite install out of git.
irises.pid

# The lifecycle e2e sandbox (npm run e2e:lifecycle) — throwaway clones, homes and logs.
scripts/e2e/.sandbox/

# Local state dir (if IRISES_HOME points into the repo)
.irises/

# Secrets — NEVER commit. Use .env.example as the template.
.env
.env.*
!.env.example

# Claude Code local state
.claude/

# --- bridge plugins (python) ---
__pycache__/
*.pyc

# --- web (Next.js debug client under web/) ---
web/.next/
web/out/
web/coverage/
web/playwright-report/
web/test-results/
web/.irises/
Irises-Hermes-E2E-Retest-Report.pdf
docs/COMPETITORS.md
scripts/convergence/results/multiturn-research-test.md
/docs/superpowers
# Finder metadata, at any depth. The three per-directory rules this replaces (root, bridge/, and
# scripts/convergence/) never matched docs/, src/, web/ or skills/, which is how seven .DS_Store
# files ended up tracked.
**/.DS_Store
/videos
docs/LLM-PRICING-AND-COST-ACCOUNTING.md
docs/DSH-SESSION-COST-REPORT.md
RELEASE_FIXES_PLAN.md
